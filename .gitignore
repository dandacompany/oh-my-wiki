# Meta/planning + generated tutorial HTML stay local. The two builders are
# published so the website can render its pinned OMW submodule without a stale
# copied source.
docs/*
!docs/tutorial-omw/
docs/tutorial-omw/*
!docs/tutorial-omw/build_tutorial_omw.py
!docs/tutorial-reference/
docs/tutorial-reference/*
!docs/tutorial-reference/build_tutorial_reference.py

# Claude Code / AI agent instructions and memory (local-only, never publish)
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
MEMORY.md
memory/
.claude/
.cate/

# Secrets / env
.env
.env.*
!.env.example

# IDE / editor config
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime state (per-user sqlite)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.migrated
!data/.gitkeep

# Virtualenv
.venv/

# Editable install metadata
*.egg-info/

# Build artifacts (sdist/wheel + the build-time bundle copy — never committed)
build/
dist/
scripts/_bundle/

# OS
.DS_Store

# uv (not used here)
uv.lock

# Per-vault runtime state (autoresearch sessions, hot cache state, etc.)
.oh-my-wiki/

# humanize-korean transient workspace
_workspace/

# Skills CLI local install artifacts (a self-copy of the skill + lockfile —
# `skills add` writes these; redundant with the repo source, never committed)
.agents/
skills-lock.json

# Understand-Anything analysis artifacts (local only)
.ua/
.understand-anything/
